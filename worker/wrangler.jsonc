{
  "name": "finc-560-finnhub",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",
  "ratelimits": [
    {
      "name": "FINNHUB_RATE_LIMITER",
      "namespace_id": "5601",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "keep_vars": true,
  "secrets": {
    "required": [
      "FINNHUB_TOKEN"
    ]
  }
}
